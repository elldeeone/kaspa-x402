{
  "name": "@kaspa-x402/core",
  "version": "1.0.0-rc.2",
  "description": "Core types and canonical encoders for Kaspa x402.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/assert-package-dist.mjs",
    "build": "node ../../scripts/build-packages.mjs @kaspa-x402/core",
    "build:self": "tsup src/index.ts --format esm --dts --clean",
    "test": "npm run build && npm run test:self",
    "test:self": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {}
}
