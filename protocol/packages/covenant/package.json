{
  "name": "@kaspa-x402/covenant",
  "version": "1.0.0-rc.2",
  "description": "Escrow covenant helpers for Kaspa x402.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/assert-package-dist.mjs",
    "build": "node ../../scripts/build-packages.mjs @kaspa-x402/covenant",
    "build:self": "tsup src/index.ts --format esm --dts --clean",
    "test": "npm run build && npm run test:self",
    "test:self": "npm run typecheck && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "blakejs": "^1.2.1"
  }
}
