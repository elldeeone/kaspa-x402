{
  "name": "@kaspa-x402/facilitator",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "Self-hosted facilitator endpoints for Kaspa x402.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs @kaspa-x402/facilitator",
    "build:self": "tsup src/index.ts --format esm --dts --clean",
    "test": "npm run build && npm run test:self",
    "test:self": "vitest run"
  },
  "dependencies": {
    "@kaspa-x402/core": "1.0.0-rc.2",
    "@kaspa-x402/server": "1.0.0-rc.2"
  }
}
