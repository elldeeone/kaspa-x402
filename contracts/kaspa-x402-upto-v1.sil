pragma silverscript ^0.1.0;

// One-shot capped authorization covenant for Kaspa x402 upto payments.
//
// The client funds this covenant for a single request. The server can settle
// once by proving the client signed the active input script and outpoint. The
// script commits to the cap, payout script hash, refund script hash, request
// hash, nonce, validity terms, and fee reserve. The server output is bounded by
// the cap, and any uncharged value beyond the documented fee reserve returns to
// the refund script.
contract KaspaX402Upto(
    pubkey client,
    pubkey server,
    byte[32] networkHash,
    byte[32] payoutScriptPublicKeyHash,
    byte[32] refundScriptPublicKeyHash,
    byte[32] requestHash,
    byte[32] nonce,
    int maxAmount,
    int validAfterDaa,
    int validBeforeDaa,
    int settlementFeeReserve
) {
    // sha256("kaspa:x402:upto-authorization:v2")
    byte[32] constant AUTHORIZATION_DOMAIN_TAG = 0xe8e4f7b53bca685ebbcda16eaf7da67146dfe993da13eed8bb9dab4f29feafca;

    // Server settles a positive charge and returns the remainder to refund.
    entrypoint function settle(
        sig serverSig,
        datasig clientAuthorization
    ) {
        require(checkSig(serverSig, server));
        require(tx.time >= validAfterDaa);
        require(validBeforeDaa > validAfterDaa);

        byte[] authorizationMsg =
            byte[](AUTHORIZATION_DOMAIN_TAG) +
            byte[](networkHash) +
            byte[](sha256(tx.inputs[this.activeInputIndex].scriptPubKey)) +
            byte[](tx.inputs[this.activeInputIndex].outpointTransactionHash) +
            byte[](byte[4](tx.inputs[this.activeInputIndex].outpointIndex)) +
            byte[](requestHash) +
            byte[](nonce);
        require(checkSigFromStack(clientAuthorization, sha256(authorizationMsg), client));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int chargedValue = tx.outputs[0].value;

        require(tx.outputs.length == 2);
        require(chargedValue > 0);
        require(chargedValue <= maxAmount);
        require(chargedValue <= inputValue);
        require(sha256(tx.outputs[0].scriptPubKey) == payoutScriptPublicKeyHash);
        require(sha256(tx.outputs[1].scriptPubKey) == refundScriptPublicKeyHash);
        require(tx.outputs[1].value >= inputValue - chargedValue - settlementFeeReserve);
    }

    // Client recovers the authorization after expiry.
    entrypoint function refund(sig clientSig) {
        require(checkSig(clientSig, client));
        require(tx.time >= validBeforeDaa);
        require(byte[8](OpTxInputSeq(this.activeInputIndex)) == byte[8](0));
        require(tx.outputs.length == 1);
        require(sha256(tx.outputs[0].scriptPubKey) == refundScriptPublicKeyHash);
    }
}
