{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaspa-x402.org/v0.1.0-alpha.4/schemas/settlement-response.schema.json",
  "title": "Kaspa x402 SettlementResponse",
  "type": "object",
  "required": ["success", "transaction"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "errorReason": {
      "type": "string"
    },
    "transaction": {
      "type": "string",
      "pattern": "^(?:|[0-9a-fA-F]{64})$"
    },
    "network": {
      "enum": ["kaspa:mainnet", "kaspa:testnet-10"]
    },
    "payer": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "extensions": {
      "type": "object",
      "properties": {
        "kaspa": {
          "$ref": "#/$defs/kaspaSettlementExtension"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "not": {
        "required": ["extra"]
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": ["success"]
      },
      "then": {
        "required": ["network", "amount"]
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": false
          }
        },
        "required": ["success"]
      },
      "then": {
        "required": ["errorReason"]
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          },
          "extensions": {
            "properties": {
              "kaspa": {
                "required": ["commitmentId"]
              }
            },
            "required": ["kaspa"]
          }
        },
        "required": ["success", "extensions"]
      },
      "then": {
        "required": ["amount", "extensions"],
        "properties": {
          "transaction": {
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "extensions": {
            "properties": {
              "kaspa": {
                "required": ["commitmentId", "chargedAmount", "channelState"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          },
          "extensions": {
            "properties": {
              "kaspa": {
                "required": ["fundingAmount"]
              }
            },
            "required": ["kaspa"]
          }
        },
        "required": ["success", "extensions"]
      },
      "then": {
        "required": ["amount", "extensions"],
        "properties": {
          "extensions": {
            "properties": {
              "kaspa": {
                "required": ["fundingAmount", "commitmentId", "chargedAmount", "channelState"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "outpoint": {
      "type": "object",
      "required": ["txid", "index"],
      "properties": {
        "txid": {
          "$ref": "#/$defs/hash32"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "kaspaSettlementExtension": {
      "type": "object",
      "properties": {
        "commitmentId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "chargedAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "fundingAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "paymentOutputIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "finality": {
          "enum": ["mempool", "accepted", "confirmed"]
        },
        "requestHash": {
          "$ref": "#/$defs/hash32"
        },
        "channelState": {
          "$ref": "https://kaspa-x402.org/v0.1.0-alpha.4/schemas/channel-state.schema.json"
        },
        "channelId": {
          "$ref": "#/$defs/hash32"
        },
        "claimOutpoint": {
          "$ref": "#/$defs/outpoint"
        },
        "continuationOutpoint": {
          "$ref": "#/$defs/outpoint"
        },
        "refundAddress": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
