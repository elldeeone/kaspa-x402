{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaspa-x402.org/v0.1.0-alpha.10/schemas/payment-required.schema.json",
  "title": "Kaspa x402 PaymentRequired",
  "type": "object",
  "required": ["x402Version", "resource", "accepts"],
  "properties": {
    "x402Version": {
      "const": 2
    },
    "resource": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paymentRequirements"
      }
    },
    "error": {
      "type": "string"
    },
    "extensions": {
      "$ref": "#/$defs/paymentExtensions"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "batchAmount": {
      "type": "string",
      "description": "Canonical non-negative decimal constrained to the signed 64-bit maximum used by the batch covenant.",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "network": {
      "enum": ["kaspa:mainnet", "kaspa:testnet-10"]
    },
    "paymentExtensions": {
      "type": "object",
      "properties": {
        "payment-identifier": {
          "$ref": "#/$defs/paymentIdentifierExtension"
        }
      },
      "additionalProperties": true
    },
    "paymentIdentifierExtension": {
      "type": "object",
      "required": ["info", "schema"],
      "properties": {
        "info": {
          "$ref": "https://kaspa-x402.org/v0.1.0-alpha.10/schemas/payment-identifier.schema.json"
        },
        "schema": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "basePaymentRequirements": {
      "type": "object",
      "required": [
        "scheme",
        "network",
        "amount",
        "asset",
        "payTo",
        "maxTimeoutSeconds",
        "extra"
      ],
      "properties": {
        "scheme": {
          "enum": ["exact", "batch-settlement"]
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "asset": {
          "const": "KAS"
        },
        "payTo": {
          "type": "string",
          "minLength": 1
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "extra": {
          "$ref": "https://kaspa-x402.org/v0.1.0-alpha.10/schemas/kaspa-requirements-extra.schema.json"
        }
      },
      "additionalProperties": true
    },
    "paymentRequirements": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/basePaymentRequirements"
            },
            {
              "properties": {
                "scheme": {
                  "const": "exact"
                },
                "extra": {
                  "type": "object",
                  "required": ["binding"],
                  "properties": {
                    "binding": {
                      "const": "kaspa-exact-v2"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/basePaymentRequirements"
            },
            {
              "properties": {
                "scheme": {
                  "const": "batch-settlement"
                },
                "network": {
                  "const": "kaspa:testnet-10"
                },
                "amount": {
                  "$ref": "#/$defs/batchAmount"
                },
                "extra": {
                  "type": "object",
                  "required": ["binding"],
                  "properties": {
                    "binding": {
                      "const": "kaspa-escrow-v2"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
