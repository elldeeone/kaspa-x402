{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaspa-x402.org/schemas/kaspa-payment-payload.schema.json",
  "title": "Kaspa x402 Payment Payload",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": [
        "exact-transaction",
        "deposit-voucher",
        "voucher",
        "refund",
        "claim"
      ]
    },
    "payerAddress": {
      "type": "string"
    },
    "profile": {
      "enum": ["standard-native", "additive"]
    },
    "challengeId": {
      "$ref": "#/$defs/hash32"
    },
    "transaction": {
      "type": "string",
      "minLength": 1
    },
    "transactionEncoding": {
      "const": "kaspa-sdk-safe-json-v2.0.0"
    },
    "transactionId": {
      "$ref": "#/$defs/hash32"
    },
    "paymentOutputIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "requestHash": {
      "$ref": "#/$defs/hash32"
    },
    "authorization": {
      "type": "object",
      "required": ["version", "inputIndex", "expiresAt", "digest", "signature"],
      "properties": {
        "version": {
          "const": "kaspa-x402-exact-request-authorization-v1"
        },
        "inputIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        },
        "digest": {
          "$ref": "#/$defs/hash32"
        },
        "signature": {
          "$ref": "#/$defs/signature64"
        }
      },
      "additionalProperties": false
    },
    "clientPublicKey": {
      "$ref": "#/$defs/pubkey32"
    },
    "refundAddress": {
      "type": "string"
    },
    "fundingTransaction": {
      "$ref": "#/$defs/hex"
    },
    "channelConfig": {
      "type": "object",
      "required": [
        "network",
        "asset",
        "templateId",
        "clientPublicKey",
        "serverPublicKey",
        "payTo",
        "refundAddress",
        "refundTimeoutDaa",
        "salt"
      ],
      "properties": {
        "network": {
          "const": "kaspa:testnet-10"
        },
        "asset": {
          "const": "KAS"
        },
        "templateId": {
          "const": "kaspa-x402-escrow-v2"
        },
        "clientPublicKey": {
          "$ref": "#/$defs/pubkey32"
        },
        "serverPublicKey": {
          "$ref": "#/$defs/pubkey32"
        },
        "payTo": {
          "type": "string"
        },
        "refundAddress": {
          "type": "string"
        },
        "refundTimeoutDaa": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,10}|[1-4][0-9]{11})$"
        },
        "salt": {
          "$ref": "#/$defs/hash32"
        }
      },
      "additionalProperties": true
    },
    "channelId": {
      "$ref": "#/$defs/hash32"
    },
    "covenantId": {
      "$ref": "#/$defs/covenantId"
    },
    "escrowAddress": {
      "type": "string"
    },
    "fundingOutpoint": {
      "$ref": "#/$defs/outpoint"
    },
    "fundingAmountSompi": {
      "$ref": "#/$defs/batchAmount"
    },
    "activeScriptPublicKey": {
      "type": "string",
      "description": "Serialized Kaspa ScriptPublicKey: uint16_be version followed by script bytes. Kaspa x402 v1 requires version 0.",
      "pattern": "^0000(?:[0-9a-fA-F]{2})+$"
    },
    "claimAmount": {
      "$ref": "#/$defs/batchAmount"
    },
    "refundAmount": {
      "$ref": "#/$defs/batchAmount"
    },
    "clientSignature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{130}$"
    },
    "voucher": {
      "type": "object",
      "required": ["covenantId", "amount", "signature"],
      "properties": {
        "covenantId": {
          "$ref": "#/$defs/covenantId"
        },
        "amount": {
          "$ref": "#/$defs/batchAmount"
        },
        "signature": {
          "$ref": "#/$defs/signature64"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "exact-transaction"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": [
          "type",
          "transaction",
          "transactionEncoding",
          "paymentOutputIndex",
          "requestHash",
          "authorization"
        ],
        "not": {
          "required": ["transactionId"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "deposit-voucher"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": [
          "type",
          "channelConfig",
          "channelId",
          "escrowAddress",
          "fundingOutpoint",
          "fundingAmountSompi",
          "activeScriptPublicKey",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "voucher"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "clientPublicKey",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "claim"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "claimAmount",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "refund"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "covenantId",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "refundAddress",
          "refundAmount",
          "clientSignature"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "batchAmount": {
      "type": "string",
      "description": "Canonical non-negative decimal constrained to the signed 64-bit maximum used by the batch covenant.",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{2})+$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "covenantId": {
      "type": "string",
      "pattern": "^(?=[0-9a-fA-F]{64}$)(?=.*[1-9a-fA-F])[0-9a-fA-F]{64}$"
    },
    "pubkey32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "signature64": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{128}$"
    },
    "outpoint": {
      "type": "object",
      "required": ["txid", "index"],
      "properties": {
        "txid": {
          "$ref": "#/$defs/hash32"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    }
  }
}
