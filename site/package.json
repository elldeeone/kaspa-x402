{
  "name": "@kaspa-x402/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static protocol reference and browser demo host.",
  "scripts": {
    "build:dependencies": "node ../protocol/scripts/build-packages.mjs @kaspa-x402/client @kaspa-x402/adapters",
    "build": "npm run build:dependencies && npm run build:self",
    "build:self": "node scripts/site-build.mjs",
    "check": "node --test scripts/site-markdown.test.mjs scripts/site-inputs.test.mjs && node scripts/site-check.mjs",
    "deploy:check": "npm run build:dependencies && node scripts/site-build.mjs --require-clean && npm run check -- --require-clean",
    "serve": "npm run build && node scripts/site-serve.mjs"
  },
  "dependencies": {
    "@kaspa-x402/core": "1.0.0-rc.2",
    "@kaspa-x402/covenant": "1.0.0-rc.2",
    "@kaspa-x402/client": "1.0.0-rc.2",
    "@kaspa-x402/adapters": "1.0.0-rc.2",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "0.28.1",
    "markdown-it": "^15.0.2",
    "wrangler": "^4.120.0"
  }
}
