# Safe defaults for `npm run proof:live:check -- --config-file live-proof.env.example`.
# Keep private keys and seed phrases out of this file. The live runner expects
# funding and signing to come from an explicit adapter module.

KASPA_X402_NETWORK=kaspa:testnet-10
KASPA_X402_RPC_URL=
KASPA_X402_FUNDING_WALLET=
KASPA_X402_DATA_DIR=.kaspa-x402-live
KASPA_X402_RECOVERY_FILE=.kaspa-x402-live/recovery.json
KASPA_X402_REPORT_FILE=.kaspa-x402-live/report.json
KASPA_X402_TIMEOUT_DAA=1800
KASPA_X402_LIVE_ADAPTER_MODULE=

# Required only for a real live run:
# KASPA_X402_LIVE_CONFIRM=I_UNDERSTAND_THIS_USES_TESTNET_FUNDS
