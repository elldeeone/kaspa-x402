# Safe defaults for `npm run proof:live:check -- --config-file live-proof.env.example`.
# Keep private keys and seed phrases out of this file. The committed reference
# adapter below spends testnet funds and writes generated signing material under
# KASPA_X402_DATA_DIR, which must remain ignored.

KASPA_X402_NETWORK=kaspa:testnet-10
KASPA_X402_RPC_URL=
# Use wallet-key:/absolute/path/to/private-key-file or a 32-byte private key
# hex supplied from your shell, not committed config.
KASPA_X402_FUNDING_WALLET=
KASPA_X402_KASPA_WASM_MODULE=
KASPA_X402_DATA_DIR=.kaspa-x402-live
KASPA_X402_RECOVERY_FILE=.kaspa-x402-live/recovery.json
KASPA_X402_REPORT_FILE=.kaspa-x402-live/report.json
KASPA_X402_TIMEOUT_DAA=1800
KASPA_X402_LIVE_ADAPTER_MODULE=./scripts/live-adapter-reference.mjs

# Required only for a real live run:
# KASPA_X402_LIVE_CONFIRM=I_UNDERSTAND_THIS_USES_TESTNET_FUNDS
