{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaspa-x402.org/schemas/kaspa-payment-payload.schema.json",
  "title": "Kaspa x402 Payment Payload",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "exact-transfer",
        "upto-authorization",
        "deposit-voucher",
        "voucher",
        "refund",
        "claim"
      ]
    },
    "payerAddress": {
      "type": "string"
    },
    "transaction": {
      "$ref": "#/$defs/hex"
    },
    "transactionId": {
      "$ref": "#/$defs/hash32"
    },
    "paymentOutputIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "requestHash": {
      "$ref": "#/$defs/hash32"
    },
    "clientPublicKey": {
      "$ref": "#/$defs/pubkey32"
    },
    "authorizationOutpoint": {
      "$ref": "#/$defs/outpoint"
    },
    "authorizationScriptPublicKey": {
      "type": "string",
      "description": "Serialized Kaspa ScriptPublicKey: uint16_le version followed by script bytes. Kaspa x402 v1 requires version 0.",
      "pattern": "^0000(?:[0-9a-fA-F]{2})+$"
    },
    "authorizationAmountSompi": {
      "$ref": "#/$defs/amount"
    },
    "refundAddress": {
      "type": "string"
    },
    "fundingTransaction": {
      "$ref": "#/$defs/hex"
    },
    "authorization": {
      "type": "object",
      "required": [
        "maxAmountSompi",
        "payTo",
        "payoutScriptPublicKeyHash",
        "refundScriptPublicKeyHash",
        "validAfterDaa",
        "validBeforeDaa",
        "settlementFeeReserveSompi",
        "nonce",
        "serverPublicKey",
        "requestHash",
        "signature"
      ],
      "properties": {
        "maxAmountSompi": {
          "$ref": "#/$defs/amount"
        },
        "payTo": {
          "type": "string"
        },
        "payoutScriptPublicKeyHash": {
          "$ref": "#/$defs/hash32"
        },
        "refundScriptPublicKeyHash": {
          "$ref": "#/$defs/hash32"
        },
        "validAfterDaa": {
          "$ref": "#/$defs/amount"
        },
        "validBeforeDaa": {
          "$ref": "#/$defs/amount"
        },
        "settlementFeeReserveSompi": {
          "$ref": "#/$defs/amount"
        },
        "nonce": {
          "$ref": "#/$defs/hash32"
        },
        "serverPublicKey": {
          "$ref": "#/$defs/pubkey32"
        },
        "requestHash": {
          "$ref": "#/$defs/hash32"
        },
        "signature": {
          "$ref": "#/$defs/signature64"
        }
      },
      "additionalProperties": true
    },
    "channelConfig": {
      "type": "object",
      "required": [
        "network",
        "asset",
        "templateId",
        "clientPublicKey",
        "serverPublicKey",
        "payTo",
        "refundAddress",
        "refundTimeoutDaa",
        "salt"
      ],
      "properties": {
        "network": {
          "enum": [
            "kaspa:mainnet",
            "kaspa:testnet-10"
          ]
        },
        "asset": {
          "const": "KAS"
        },
        "templateId": {
          "const": "kaspa-x402-escrow-v1"
        },
        "clientPublicKey": {
          "$ref": "#/$defs/pubkey32"
        },
        "serverPublicKey": {
          "$ref": "#/$defs/pubkey32"
        },
        "payTo": {
          "type": "string"
        },
        "refundAddress": {
          "type": "string"
        },
        "refundTimeoutDaa": {
          "$ref": "#/$defs/amount"
        },
        "salt": {
          "$ref": "#/$defs/hash32"
        }
      },
      "additionalProperties": true
    },
    "channelId": {
      "$ref": "#/$defs/hash32"
    },
    "escrowAddress": {
      "type": "string"
    },
    "fundingOutpoint": {
      "$ref": "#/$defs/outpoint"
    },
    "fundingAmountSompi": {
      "$ref": "#/$defs/amount"
    },
    "activeScriptPublicKey": {
      "type": "string",
      "description": "Serialized Kaspa ScriptPublicKey: uint16_le version followed by script bytes. Kaspa x402 v1 requires version 0.",
      "pattern": "^0000(?:[0-9a-fA-F]{2})+$"
    },
    "claimAmount": {
      "$ref": "#/$defs/amount"
    },
    "refundAmount": {
      "$ref": "#/$defs/amount"
    },
    "clientSignature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{130}$"
    },
    "voucher": {
      "type": "object",
      "required": [
        "amount",
        "signature"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "signature": {
          "$ref": "#/$defs/signature64"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "exact-transfer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "transaction",
          "paymentOutputIndex"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "upto-authorization"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "clientPublicKey",
          "authorizationOutpoint",
          "authorizationScriptPublicKey",
          "authorizationAmountSompi",
          "refundAddress",
          "authorization"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "deposit-voucher"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "channelConfig",
          "channelId",
          "escrowAddress",
          "fundingOutpoint",
          "fundingAmountSompi",
          "activeScriptPublicKey",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "voucher"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "clientPublicKey",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "claim"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "claimAmount",
          "voucher"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "refund"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type",
          "channelId",
          "fundingOutpoint",
          "activeScriptPublicKey",
          "refundAddress",
          "refundAmount",
          "clientSignature"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{2})+$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "pubkey32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "signature64": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{128}$"
    },
    "outpoint": {
      "type": "object",
      "required": [
        "txid",
        "index"
      ],
      "properties": {
        "txid": {
          "$ref": "#/$defs/hash32"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    }
  }
}
