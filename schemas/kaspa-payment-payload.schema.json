{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaspa-x402.org/schemas/kaspa-payment-payload.schema.json",
  "title": "Kaspa x402 Payment Payload",
  "type": "object",
  "required": ["type", "channelId", "clientPublicKey"],
  "properties": {
    "type": {
      "enum": ["deposit-voucher", "voucher", "refund", "claim"]
    },
    "channelId": {
      "type": "string",
      "minLength": 32
    },
    "clientPublicKey": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "escrowAddress": {
      "type": "string"
    },
    "fundingOutpoint": {
      "type": "object",
      "required": ["txid", "index"],
      "properties": {
        "txid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fundingAmountSompi": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "voucher": {
      "type": "object",
      "required": ["amountSompi", "signature"],
      "properties": {
        "amountSompi": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{128}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

