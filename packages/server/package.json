{
  "name": "@kaspa-x402/server",
  "version": "1.0.0-rc.1",
  "description": "Server SDK for Kaspa x402.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hash-chain-grants": {
      "types": "./dist/hash-chain-grants.d.ts",
      "import": "./dist/hash-chain-grants.js"
    },
    "./hash-chain-issuer": {
      "types": "./dist/hash-chain-issuer.d.ts",
      "import": "./dist/hash-chain-issuer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/assert-package-dist.mjs",
    "build": "npm --workspace @kaspa-x402/core run build && npm --workspace @kaspa-x402/covenant run build && npm run build:self",
    "build:self": "tsup src/index.ts --format esm --dts --clean && tsup src/hash-chain-grants.ts src/hash-chain-issuer.ts --format esm --dts --platform node",
    "test": "npm run build && npm run test:self",
    "test:self": "vitest run"
  },
  "dependencies": {
    "@kaspa-x402/core": "1.0.0-rc.1",
    "@kaspa-x402/covenant": "1.0.0-rc.1",
    "@noble/curves": "^2.2.0"
  }
}
